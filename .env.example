# Copy this file to .env and fill in every value. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------------------------
# Token that BotFather returns for your bot (https://t.me/BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header on every
# delivery. It is what proves a request to the public webhook really came from Telegram.
# Generate your own, 1-256 characters, only A-Z a-z 0-9 _ and -:
#
#   openssl rand -hex 32
#
TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ---------------------------------------------------------------------------------------------
# ngrok
# ---------------------------------------------------------------------------------------------
# Authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ---------------------------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------------------------
POSTGRES_DB=encodelabs_inbox
POSTGRES_USER=encodelabs_inbox
# Choose your own. Keep it alphanumeric: it is also embedded in a connection string.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=encodelabs_inbox
# Choose your own. Keep it alphanumeric: it is also embedded in the amqp:// URI.
RABBITMQ_DEFAULT_PASS=
