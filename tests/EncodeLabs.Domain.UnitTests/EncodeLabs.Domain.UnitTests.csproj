<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      An xUnit v3 test project is a self-hosting executable that runs on Microsoft.Testing.Platform.
      Run it with "dotnet run", passing this project; see docs/code-review.md (CR-002) for why
      "dotnet test" is not the documented command on this SDK build.
    -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\EncodeLabs.Domain\EncodeLabs.Domain.csproj" />
  </ItemGroup>

</Project>
