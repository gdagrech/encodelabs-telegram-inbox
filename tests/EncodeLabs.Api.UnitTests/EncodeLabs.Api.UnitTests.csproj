<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Self-hosting runner: run with "dotnet run", not "dotnet test". See docs/code-review.md (CR-002). -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The API is a web project, so the test project needs the same framework reference to load it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging abstractions arrive with the ASP.NET Core framework reference above. -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\EncodeLabs.Api\EncodeLabs.Api.csproj" />
  </ItemGroup>

</Project>
